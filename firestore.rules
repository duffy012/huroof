rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == "dhaaaariiii@gmail.com"; }

    match /games/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.by == request.auth.uid
                    && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow update, delete: if signedIn() && (resource.data.by == request.auth.uid || isAdmin());
    }

    match /questions/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.by == request.auth.uid
                    && request.resource.data.q is string && request.resource.data.q.size() <= 500
                    && request.resource.data.a is string && request.resource.data.a.size() <= 100
                    && exists(/databases/$(database)/documents/games/$(request.resource.data.g));
      allow update, delete: if signedIn() && (resource.data.by == request.auth.uid || isAdmin()
                    || get(/databases/$(database)/documents/games/$(resource.data.g)).data.by == request.auth.uid);
    }
  }
}
